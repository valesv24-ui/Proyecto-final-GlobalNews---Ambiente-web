# Copie este archivo como .env y complete los valores
PORT=3001
NODE_ENV=development
# URL del frontend (React) que puede consumir la API
CLIENT_URL=http://localhost:5173

# Base de datos PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=su_contraseña
DB_NAME=globalnews

# Autenticación con JWT
# Use un texto largo y aleatorio. Para generar uno:
# node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambie_esto_por_un_texto_largo_y_aleatorio
JWT_EXPIRES_IN=8h
